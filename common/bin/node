#
# bun as node. aube's npm shim for markdownlint-cli2 ends in
# `exec node <entry>`; prose.sh puts this directory first on PATH so it runs
# on the pinned bun rather than needing Node.js. Scoped to prose.sh only — it
# never shadows a Node repo's own node anywhere else.
exec bun "$@"
